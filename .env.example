# SAI-P4 environment configuration.
# Copy to `.env` and edit. All values have safe local-dev defaults, so this
# file is only needed to override them (e.g. real LiveKit keys in production).

# --- LiveKit (participant video/audio SFU) ---
# For local dev, LiveKit's `--dev` server uses the well-known keys below.
# For ANY non-local deployment, generate real credentials and set them here.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Researcher endpoint protection (optional) ---
# If set, researcher-only API routes require this key in the `x-api-key` header.
# Leave empty to disable the check (fine for a trusted LAN).
EXPERIMENT_API_KEY=

# --- Ollama (LLM backend for the facilitator) ---
# Used by scripts/start.sh to health-check Ollama before launch.
# The model itself is configured in backend/app/config.py (OllamaConfig.model).
OLLAMA_HOST=http://localhost:11434
